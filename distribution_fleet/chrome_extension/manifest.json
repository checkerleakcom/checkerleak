{
  "manifest_version": 3,
  "name": "CheckerLeak — Phone Carrier & VoIP Intelligence",
  "version": "1.0.0",
  "description": "Right-click or test any international phone number for Carrier HLR, VoIP fraud risk, and multi-platform footprint.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://checkerleak.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
